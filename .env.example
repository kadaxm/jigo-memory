# copy to .env — never commit .env
GEMINI_API_KEY=            # free tier; add GEMINI_API_KEY_2, _3 ... for rotation
ELEVENLABS_API_KEY=        # STT (Scribe) + fallback TTS; needs speech_to_text scope
OPENROUTER_API_KEY=        # optional primary text provider
OPENROUTER_MODEL=          # a model id that exists today (stealth/ox-alpha now returns 404)
OBSIDIAN_VAULT=            # optional, for obsidian_sync.py
JIGO_ROAST=0               # 1 enables roast mode on good news
JIGO_PERSONA=1             # comfort replies when you sound low
JIGO_GU_BANK=1             # play pre-rendered rumik-oss-1 Gujarati lines
JIGO_TTS_INDIC_LANG=hi     # "en" disables the Hindi-phonology mapping for romanized Gujarati
JIGO_UNLOAD_SECONDS=600    # voice server idle unload
JIGO_TTS_ENGINE=auto       # auto = clone first, ElevenLabs fallback; eleven = skip the clone (loaded laptops)
